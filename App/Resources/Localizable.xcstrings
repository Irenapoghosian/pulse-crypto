    "System follows your iPhone's Light or Dark setting. Home Screen widgets always follow the system." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "System follows your iPhone's Light or Dark setting. Home Screen widgets always follow the system."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Համակարգային»-ը հետևում է iPhone-ի բաց կամ մուգ կարգավորմանը։ Հիմնական էկրանի վիջեթները միշտ հետևում են համակարգին։"
